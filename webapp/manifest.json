{
  "_version": "1.73.1",
  "sap.app": {
    "id": "zflight.flightlistrepevi",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:lrop",
      "version": "1.19.3",
      "toolsId": "b89d9276-4c6e-4b3c-977b-cb7be7a62bf3"
    },
    "dataSources": {
      "annotation": {
        "type": "ODataAnnotation",
        "uri": "annotations/annotation.xml",
        "settings": {
          "localUri": "annotations/annotation.xml"
        }
      },
      "mainService": {
        "uri": "/sap/opu/odata4/sap/zui_flight_evi_o4/srvd/sap/zui_flight_evi_o4/0001/",
        "type": "OData",
        "settings": {
          "annotations": [
            "annotation"
          ],
          "localUri": "localService/mainService/metadata.xml",
          "odataVersion": "4.0"
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
"GeoMap": {
  "template": "zflight.flightlistrepevi.ext.fragment.GeoMap",
  "title": "Itinerary",
  "position": {
    "placement": "After",
    "anchor": "Flight Details (ID: FlightDetails)"
  }
},
  
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.136.8",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.fe.templates": {},
         "sap.fe.macros": {},
        "sap.ui.vbm": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "zflight.flightlistrepevi.i18n.i18n"
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      },
      "@i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "uri": "i18n/i18n.properties"
      }
    },
    "resources": {
      "css": []
    },
    "routing": {
      "config": {},
      "routes": [
        {
          "pattern": ":?query:",
          "name": "FlightList",
          "target": "FlightList"
        },
        {
          "pattern": "Flight({key}):?query:",
          "name": "FlightObjectPage",
          "target": "FlightObjectPage"
        },
        {
          "pattern": "Flight({key})/_DetailEVI({key2}):?query:",
          "name": "FlightDetailsEVIObjectPage",
          "target": "FlightDetailsEVIObjectPage"
        }
      ],
      "targets": {
        "FlightList": {
          "type": "Component",
          "id": "FlightList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/Flight",
              "variantManagement": "Page",
              "navigation": {
                "Flight": {
                  "detail": {
                    "route": "FlightObjectPage"
                  }
                }
              },
              "controlConfiguration": {
                "@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "type": "ResponsiveTable"
                  }
                }
              }
            }
          }
        },
        "FlightObjectPage": {
          "type": "Component",
          "id": "FlightObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "editableHeaderContent": false,
              "contextPath": "/Flight",
              "navigation": {
                "_DetailEVI": {
                  "detail": {
                    "route": "FlightDetailsEVIObjectPage"
                  }
                }
              }
            }
          }
        },
        "FlightDetailsEVIObjectPage": {
          "type": "Component",
          "id": "FlightDetailsEVIObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "editableHeaderContent": false,
              "contextPath": "/Flight/_DetailEVI",
              "content": {
                "body": {
                  "sections": {
                    "GeoMap": {
                      "template": "zflight.flightlistrepevi.ext.fragment.GeoMap",
                      "position": {
                        "placement": "After",
                        "anchor": "General Information (ID: GeneralInfo)"
                      },
                      "title": "Itinerary"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "sap.fiori": {
    "registrationIds": [],
    "archeType": "transactional"
  }
}
