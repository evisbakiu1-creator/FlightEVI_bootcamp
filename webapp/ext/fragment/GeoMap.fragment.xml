<core:FragmentDefinition
  xmlns="sap.m"
  xmlns:core="sap.ui.core"
  xmlns:vbm="sap.ui.vbm"
  xmlns:macros="sap.fe.macros"
  displayBlock="true">

  <VBox id="itineraryVBox">


    <HBox id="itineraryBar" class="sapUiSmallMarginBottom">
      <Text id="txtConfirmedOn" text="The bookings were confirmed on" class="sapUiTinyMarginEnd"/>
      <macros:Field id="fldCreatedAt" readOnly="true" metaPath="CreatedAt"/>
      <Text id="txtBy" text="by" class="sapUiTinyMarginBeginEnd"/>
      <macros:Field id="fldAgencyId" readOnly="true" metaPath="AgencyID"/>
    </HBox>

    
    <vbm:AnalyticMap id="amItinerary"
                     width="100%"
                     height="600px"
                     initialZoom="4"
                     initialPosition="0;30">

      <vbm:vos>
        <vbm:Routes id="routesItinerary">
          <vbm:Route id="routeFraJfk"
                     position="8.682127;50.110924;0;-73.780968;40.641766;0"
                     color="RGB(0,128,255)" dotcolor="RGB(255,0,0)"
                     start="0" end="1" linewidth="2"/>
          <vbm:Route id="routeJfkSfo"
                     position="-73.780968;40.641766;0;-122.389777;37.615223;0"
                     color="RGB(0,128,255)" dotcolor="RGB(255,0,0)"
                     start="0" end="1" linewidth="2"/>
          <vbm:Route id="routeSfoFra"
                     position="-122.389777;37.615223;0;8.682127;50.110924;0"
                     color="RGB(0,128,255)" dotcolor="RGB(255,0,0)"
                     start="0" end="1" linewidth="2"/>
        </vbm:Routes>

        <vbm:Spots id="spotsItinerary">
          <vbm:Spot id="spotFRA"
                    position="8.682127;50.110924;0"
                    tooltip="Frankfurt am Main (FRA)"
                    type="Success"/>
          <vbm:Spot id="spotJFK"
                    position="-73.780968;40.641766;0"
                    tooltip="New York (JFK)"
                    type="Default"/>
          <vbm:Spot id="spotSFO"
                    position="-122.389777;37.615223;0"
                    tooltip="San Francisco (SFO)"
                    type="Error"/>
        </vbm:Spots>
      </vbm:vos>

    </vbm:AnalyticMap>
  </VBox>
</core:FragmentDefinition>
