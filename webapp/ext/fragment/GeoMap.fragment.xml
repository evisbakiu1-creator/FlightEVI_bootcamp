<core:FragmentDefinition
  xmlns="sap.m"
  xmlns:core="sap.ui.core"
  xmlns:vbm="sap.ui.vbm"
  xmlns:macro="sap.fe.macros"
  displayBlock="true">

  <vbm:AnalyticMap
      id="IDGenAnalyticMap1"
      width="100%"
      height="600px"
      initialZoom="4"
      initialPosition="0;30">

    <vbm:vos>
      <!-- ROUTES between cities -->
      <vbm:Routes id="IDGenRoutes">
        <vbm:Route id="IDGenRoute0"
                   position="8.682127;50.110924;0;-73.780968;40.641766;0"
                   color="RGB(0,128,255)"
                   dotcolor="RGB(255,0,0)"
                   end="1" start="0" linewidth="2"/>
        <vbm:Route id="IDGenRoute1"
                   position="-73.780968;40.641766;0;-122.389777;37.615223;0"
                   color="RGB(0,128,255)"
                   dotcolor="RGB(255,0,0)"
                   end="1" start="0" linewidth="2"/>
        <vbm:Route id="IDGenRoute2"
                   position="-122.389777;37.615223;0;8.682127;50.110924;0"
                   color="RGB(0,128,255)"
                   dotcolor="RGB(255,0,0)"
                   end="1" start="0" linewidth="2"/>
      </vbm:Routes>

      <!-- SPOTS for major airports -->
      <vbm:Spots id="IDGenSpots">
        <vbm:Spot id="IDGenSpot0"
                  position="8.682127;50.110924;0"
                  tooltip="Frankfurt am Main (FRA)"
                  type="Success"/>
        <vbm:Spot id="IDGenSpot1"
                  position="-73.780968;40.641766;0"
                  tooltip="New York (JFK)"
                  type="Default"/>
        <vbm:Spot id="IDGenSpot2"
                  position="-122.389777;37.615223;0"
                  tooltip="San Francisco (SFO)"
                  type="Error"/>
      </vbm:Spots>
    </vbm:vos>
  </vbm:AnalyticMap>
</core:FragmentDefinition>