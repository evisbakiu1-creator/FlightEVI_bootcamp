<edmx:Edmx xmlns:edmx="http://docs.oasis-open.org/odata/ns/edmx" Version="4.0">
  <!-- vocabularies -->
  <edmx:Reference Uri="https://sap.github.io/odata-vocabularies/vocabularies/Common.xml">
    <edmx:Include Namespace="com.sap.vocabularies.Common.v1" Alias="Common"/>
  </edmx:Reference>
  <edmx:Reference Uri="https://sap.github.io/odata-vocabularies/vocabularies/UI.xml">
    <edmx:Include Namespace="com.sap.vocabularies.UI.v1" Alias="UI"/>
  </edmx:Reference>
  <edmx:Reference Uri="https://sap.github.io/odata-vocabularies/vocabularies/Communication.xml">
    <edmx:Include Namespace="com.sap.vocabularies.Communication.v1" Alias="Communication"/>
  </edmx:Reference>

  <!-- reference your service namespace; alias SAP__self is correct -->
  <edmx:Reference Uri="/sap/opu/odata4/sap/zui_flight_evi_o4/srvd/sap/zui_flight_evi_o4/0001/$metadata">
    <edmx:Include Namespace="com.sap.gateway.srvd.zui_flight_evi_o4.v0001" Alias="SAP__self"/>
  </edmx:Reference>

  <edmx:DataServices>
    <Schema xmlns="http://docs.oasis-open.org/odata/ns/edm" Namespace="local">

      <!-- Show ONLY Carrier Id + Name in Filter Bar -->
      <Annotations Target="SAP__self.Carrier">
        <Annotation Term="UI.SelectionFields">
          <Collection>
            <PropertyPath>Carrid</PropertyPath>
            <PropertyPath>Carrname</PropertyPath>
          </Collection>
        </Annotation>

        <!-- Table columns (order below); anything not listed is hidden -->
        <Annotation Term="UI.LineItem">
          <Collection>
            <Record Type="UI.DataField">
              <PropertyValue Property="Value" Path="Carrid"/>
            </Record>
            <Record Type="UI.DataField">
              <PropertyValue Property="Value" Path="Carrname"/>
            </Record>
            <Record Type="UI.DataField">
              <PropertyValue Property="Value" Path="Currcode"/>
            </Record>
            <Record Type="UI.DataField">
              <PropertyValue Property="Value" Path="Url"/>
            </Record>
          </Collection>
        </Annotation>
      </Annotations>

      <!-- Also hide audit fields from Adapt Filters (optional) -->
      <Annotations Target="SAP__self.Carrier/CreatedOn">
        <Annotation Term="UI.HiddenFilter"><Bool>true</Bool></Annotation>
      </Annotations>
      <Annotations Target="SAP__self.Carrier/CreatedBy">
        <Annotation Term="UI.HiddenFilter"><Bool>true</Bool></Annotation>
      </Annotations>
      <Annotations Target="SAP__self.Carrier/ChangedOn">
        <Annotation Term="UI.HiddenFilter"><Bool>true</Bool></Annotation>
      </Annotations>
      <Annotations Target="SAP__self.Carrier/ChangedBy">
        <Annotation Term="UI.HiddenFilter"><Bool>true</Bool></Annotation>
      </Annotations>

    </Schema>
  </edmx:DataServices>
</edmx:Edmx>
